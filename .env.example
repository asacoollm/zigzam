# ============================================================
#  ZIGZAM — Variables d'environnement (modèle)
#  Copie ce fichier en ".env" et remplis les valeurs.
#  Récupère-les dans Supabase → Project Settings → API.
#  (Le vrai .env est ignoré par git : ne JAMAIS y mettre de secret en clair ici.)
# ============================================================

# URL du projet Supabase (ex : https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clé "anon" / publishable Supabase (clé publique, côté client)
VITE_SUPABASE_ANON_KEY=
